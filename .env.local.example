NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable key from `supabase status`>
SUPABASE_SERVICE_ROLE_KEY=<secret key from `supabase status` — only needed for E2E seed scripts>
ADMIN_EMAIL_ALLOWLIST=junwangwrk@gmail.com

# E2E test credentials (only needed for e2e tests; values live in .env.local)
E2E_ADMIN_EMAIL=junwangwrk@gmail.com
E2E_ADMIN_PASSWORD=<set this; will match the password chosen when creating the admin user>
