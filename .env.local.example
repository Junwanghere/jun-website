# 本機 Supabase（`supabase start` 後的固定預設值；每台機器相同，可直接沿用）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# 後台白名單（可登入 /admin 的 email；逗號分隔多筆）
# 注意：這裡必須與資料庫 admin_emails 資料表一致——新增管理員時兩邊都要改，否則
# 會發生「應用層放行但 RLS 擋下」的怪象。詳見 README「新增管理員」。
ADMIN_EMAIL_ALLOWLIST=junwangwrk@gmail.com

# 本機 admin / E2E 帳號（由 `pnpm seed:admin` 建立）
# 注意：這是本機開發/測試專用、隨 db:reset 可重建的拋棄式帳號，非正式環境 secret。
E2E_ADMIN_EMAIL=junwangwrk@gmail.com
E2E_ADMIN_PASSWORD=local-dev-admin-pw

# YouTube 排程同步（SUPABASE_SERVICE_ROLE_KEY 已於上方定義，毋須重複）
YOUTUBE_CHANNEL_ID=
CRON_SECRET=
